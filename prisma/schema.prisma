generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  SUBMITTED
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum PaymentStatus {
  COD_PENDING
  CREATED
  PENDING
  CAPTURED
  FAILED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  PARTIALLY_REFUNDED
  EXPIRED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum DiscountType {
  NONE
  DISCOUNT_ON_PTR
  SAME_PRODUCT_BONUS
  DIFFERENT_PRODUCT_BONUS
  SAME_PRODUCT_BONUS_AND_DISCOUNT
  DIFFERENT_PRODUCT_BONUS_AND_DISCOUNT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  shopName     String?
 gstNumber    String?
drugLicence20B String
drugLicence21B String
  profileImage String?
  address      String?
  city         String?
  state        String?
  pincode      String?
  role         Role     @default(CUSTOMER)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id                   String  @id @default(cuid())
  name                 String
  company              String
  composition          String
  category             String
  medicineType         String?
  productType          String?
  pack                 String
  countryOfOrigin      String?
  sku                  String  @unique
  barcode              String? @unique
  prescriptionRequired Boolean @default(false)
  image                String?
  description          String?

  // Kept temporarily so the existing customer/order APIs continue working.
  mrp Decimal  @db.Decimal(10, 2)
  ptr Decimal @db.Decimal(10, 2)
  gst Decimal? @default(5) @db.Decimal(5, 2)

  discountType   DiscountType @default(NONE)
  discountValue  Decimal      @default(0) @db.Decimal(10, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  effectivePtr   Decimal?     @db.Decimal(10, 2)

  buyQuantity    Int?
  freeQuantity   Int?
  bonusProductId String?
  net            Decimal  @db.Decimal(10, 2)
  expiry         DateTime
  stock          Int      @default(0)
  minOrderQuantity Int    @default(1)
  isActive       Boolean  @default(true)

  inventoryBatches InventoryBatch[]
  orderItems       OrderItem[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([name, company, pack])
  @@index([name])
  @@index([composition])
  @@index([company])
  @@index([category])
}

model InventoryBatch {
  id           String   @id @default(cuid())
  productId    String
  batchNumber  String
  quantity     Int      @default(0)
  freeQuantity Int      @default(0)
  mrp          Decimal  @db.Decimal(10, 2)
  ptr          Decimal  @db.Decimal(10, 2)
  discount     Decimal  @default(0) @db.Decimal(10, 2)
  gst          Decimal  @default(0) @db.Decimal(5, 2)
  expiryDate   DateTime
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, batchNumber])
  @@index([productId])
  @@index([expiryDate])
}

model Order {
  id              String             @id @default(cuid())
  orderNumber     String             @unique
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  deliveryName    String
  deliveryShop    String
  deliveryPhone   String
  deliveryAddress String
  subtotal        Decimal            @db.Decimal(12, 2)
  gstTotal        Decimal            @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal            @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal            @default(0) @db.Decimal(12, 2)
  status          OrderStatus        @default(SUBMITTED)
  items           OrderItem[]
  statusHistory   OrderStatusEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  paymentMethod   PaymentMethod      @default(COD)
  payments        Payment[]
  idempotencyKey  String?
  refunds         Refund[]
  stockDeductedAt DateTime?
  stockRestoredAt DateTime?
  cancelledAt     DateTime?
  deliveryPartner String?
  trackingId      String?
  cancellationReason String?
  invoiceFileName String?
  invoiceMimeType String?
  invoiceData     Bytes?
  invoiceUrl      String?
  invoiceUploadedAt DateTime?

  @@index([userId, createdAt])
  @@unique([userId, idempotencyKey])
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              String        @default("RAZORPAY")
  status                PaymentStatus @default(CREATED)
  amountPaise           Int
  currency              String        @default("INR")
  razorpayOrderId       String?       @unique
  razorpayPaymentId     String?       @unique
  razorpaySignature     String?
  failureCode           String?
  failureDescription    String?
  capturedAt            DateTime?
  refundedPaise         Int           @default(0)
  refundId              String?       @unique
  refundStatus          String?
  refunds               Refund[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([orderId, createdAt])
  @@index([status])
  @@index([status, createdAt])
}

model Refund {
  id                    String       @id @default(cuid())
  orderId               String
  paymentId             String
  requestedById         String
  razorpayRefundId      String?      @unique
  idempotencyKey        String       @unique
  amountPaise           Int
  currency              String       @default("INR")
  status                RefundStatus @default(PENDING)
  reason                String?
  providerFailure       String?
  completedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment               Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  providerId  String   @unique
  event       String
  payload     Json
  receivedAt  DateTime @default(now())
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  ptr         Decimal? @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  paidQuantity Int @default(0)
  freeQuantity Int @default(0)
  totalQuantity Int @default(0)
  stripsPerBox Int @default(1)
  isFree      Boolean @default(false)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ProductImport {
  id        String   @id @default(cuid())
  fileName  String
  created   Int
  updated   Int
  failed    Int
  errors    Json?
  createdAt DateTime @default(now())
}
